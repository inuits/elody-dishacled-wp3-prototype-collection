# Interim contract catalog for the WP3 prototype.
#
# Hand-authored stand-in for the central DiSHACLed catalog: it gives each demo
# pipeline component an input and an output shape alongside its config shape,
# so components can be connected (B2) and the chain validated (B3). Datasets
# declare an output shape only -- they produce data but consume none.
#
# Vocabulary follows the DiSHACLed discovery specification
# (https://dishacled.github.io/discovery-specification/):
#
#   * 2.2 `dcat:qualifiedRelation` -> `dcat:hadRole` -> `dcterms:relation`
#     carries the role-bearing links. This is the form the reference catalog
#     uses (thcarsten/toolchain-specification, catalog-rdfc.ttl), which is why
#     the config role reuses its `tcs:configShape`; `tcs:inputShape` and
#     `tcs:outputShape` are new but follow the same namespace and casing.
#   * 2.1 `dcterms:conformsTo` additionally lists the same shapes without a
#     role. The spec states a client treats the alternatives as a logical OR
#     with no prioritisation, so declaring both is valid and lets a plain
#     conformsTo-only reader still find the shapes.
#
# Components are concrete per-unit variants rather than one generic component
# with a unit parameter, so a unit mismatch is visible in the catalog itself:
#
#   HttpPollerCm -> ThresholdMonitorCm   cm -> cm, compatible
#   HttpPollerMm -> ThresholdMonitorCm   mm -> cm, mismatch (the B3 demo)
#
# Each component also carries the `rdfc:jsImplementationOf` triples a real
# processor.ttl would. That class IRI is the join key used to attach these
# contracts to a processor discovered from GitHub, and it lets the existing
# config-form and pipeline-export machinery consume a component from this file
# unchanged.

@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix spdx:    <http://spdx.org/rdf/terms#> .
@prefix tcs:     <https://w3id.org/toolchain#> .
@prefix rdfc:    <https://w3id.org/rdf-connect#> .
@prefix demo:    <https://dishacled.github.io/demo#> .
@prefix :        <http://example.org/example/> .

# The alert vocabulary, as the threshold-monitor processor declares it.
@prefix oslc:    <http://open-services.net/ns/core#> .
@prefix mu:      <http://mu.semte.ch/vocabularies/core/> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix tm:      <https://w3id.org/rdf-connect/threshold-monitor#> .
@prefix lblodsh: <http://lblod.data.gift/shapes/> .


#################################################################
# Deployment coordinates
#
# Shapes describe how a component is configured and connected; they say
# nothing about how to obtain it. The toolchain pipeline generator needs the
# second half too: `spdx:Package` becomes an entry in the generated
# package.json / pyproject.toml, and `owl:imports` is what the RDF-Connect
# runner follows to locate the processor definition at start-up.
#
# The `:npm` / `:pip` supplier IRIs are the ones the reference catalog uses
# (`http://example.org/example/`); the generator routes packages to a manifest
# file by matching on exactly those.
#
# PLACEHOLDER: the demo components below have no published package. The
# coordinates are shaped correctly and route correctly, but installing them
# will fail until the components are actually released -- an exported pipeline
# that includes one needs its coordinates replaced before `docker compose up`.
#################################################################


#################################################################
# Interface shapes
#
# Constant, shared by every component that speaks the unit. Identity of these
# IRIs is what makes an output/input pair comparable; `sh:hasValue` is what
# makes the comparison enforceable by an actual SHACL validation run.
#################################################################

demo:MeasurementsInCmShape a sh:NodeShape ;
  rdfs:label "Measurements in cm" ;
  sh:targetClass demo:Measurement ;
  sh:property [
    sh:path demo:unit ;
    sh:name "unit" ;
    sh:datatype xsd:string ;
    sh:hasValue "cm" ;
    sh:in ( "cm" ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 0 ;
  ] , [
    sh:path demo:value ;
    sh:name "value" ;
    sh:datatype xsd:decimal ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 1 ;
  ] , [
    sh:path demo:observedAt ;
    sh:name "observedAt" ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:order 2 ;
  ] .

demo:MeasurementsInMmShape a sh:NodeShape ;
  rdfs:label "Measurements in mm" ;
  sh:targetClass demo:Measurement ;
  sh:property [
    sh:path demo:unit ;
    sh:name "unit" ;
    sh:datatype xsd:string ;
    sh:hasValue "mm" ;
    sh:in ( "mm" ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 0 ;
  ] , [
    sh:path demo:value ;
    sh:name "value" ;
    sh:datatype xsd:decimal ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 1 ;
  ] , [
    sh:path demo:observedAt ;
    sh:name "observedAt" ;
    sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:order 2 ;
  ] .


#################################################################
# threshold-monitor-cm
#
# The canonical spelling: `a dcat:Relationship` present, inline config shape,
# IRI references for the interface shapes.
#################################################################

demo:ThresholdMonitorCm a tcs:PipelineComponent, dcat:DataService ;
  rdfs:label "Threshold monitor (cm)" ;
  rdfs:comment "Passes through centimetre measurements and flags the ones crossing a threshold." ;
  rdfc:jsImplementationOf rdfc:Processor ;
  rdfc:class "ThresholdMonitorCm" ;
  rdfc:file <./dist/threshold-monitor-cm.js> ;
  rdfc:entrypoint <./> ;
  owl:imports <./node_modules/@dishacled/demo-processors/processors.ttl> ;
  dcterms:requires [
    a spdx:Package ;
    spdx:name "@dishacled/demo-processors" ;
    spdx:versionInfo "^0.1.0" ;
    spdx:suppliedBy :npm ;
  ] ;
  dcterms:conformsTo demo:MeasurementsInCmShape ;
  dcat:qualifiedRelation [
    a dcat:Relationship ;
    dcat:hadRole tcs:configShape ;
    dcterms:relation [
      a sh:NodeShape ;
      sh:targetClass demo:ThresholdMonitorCm ;
      sh:property [
        sh:path demo:threshold ;
        sh:name "threshold" ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
      ] , [
        sh:path demo:direction ;
        sh:name "direction" ;
        sh:datatype xsd:string ;
        sh:in ( "above" "below" ) ;
        sh:maxCount 1 ;
        sh:order 1 ;
      ] , [
        sh:path rdfc:input ;
        sh:name "input" ;
        sh:class rdfc:Reader ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 2 ;
      ] , [
        sh:path rdfc:output ;
        sh:name "output" ;
        sh:class rdfc:Writer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 3 ;
      ]
    ]
  ] , [
    a dcat:Relationship ;
    dcat:hadRole tcs:inputShape ;
    dcterms:relation demo:MeasurementsInCmShape ;
  ] , [
    a dcat:Relationship ;
    dcat:hadRole tcs:outputShape ;
    dcterms:relation demo:MeasurementsInCmShape ;
  ] .


#################################################################
# threshold-monitor-mm
#
# Same structure, but the relation nodes omit `a dcat:Relationship`. The
# reference catalog omits it too, so the parser must not depend on it.
#################################################################

demo:ThresholdMonitorMm a tcs:PipelineComponent, dcat:DataService ;
  rdfs:label "Threshold monitor (mm)" ;
  rdfs:comment "Passes through millimetre measurements and flags the ones crossing a threshold." ;
  rdfc:jsImplementationOf rdfc:Processor ;
  rdfc:class "ThresholdMonitorMm" ;
  rdfc:file <./dist/threshold-monitor-mm.js> ;
  rdfc:entrypoint <./> ;
  owl:imports <./node_modules/@dishacled/demo-processors/processors.ttl> ;
  dcterms:requires [
    a spdx:Package ;
    spdx:name "@dishacled/demo-processors" ;
    spdx:versionInfo "^0.1.0" ;
    spdx:suppliedBy :npm ;
  ] ;
  dcterms:conformsTo demo:MeasurementsInMmShape ;
  dcat:qualifiedRelation [
    dcat:hadRole tcs:configShape ;
    dcterms:relation [
      a sh:NodeShape ;
      sh:targetClass demo:ThresholdMonitorMm ;
      sh:property [
        sh:path demo:threshold ;
        sh:name "threshold" ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
      ] , [
        sh:path demo:direction ;
        sh:name "direction" ;
        sh:datatype xsd:string ;
        sh:in ( "above" "below" ) ;
        sh:maxCount 1 ;
        sh:order 1 ;
      ] , [
        sh:path rdfc:input ;
        sh:name "input" ;
        sh:class rdfc:Reader ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 2 ;
      ] , [
        sh:path rdfc:output ;
        sh:name "output" ;
        sh:class rdfc:Writer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 3 ;
      ]
    ]
  ] , [
    dcat:hadRole tcs:inputShape ;
    dcterms:relation demo:MeasurementsInMmShape ;
  ] , [
    dcat:hadRole tcs:outputShape ;
    dcterms:relation demo:MeasurementsInMmShape ;
  ] .


#################################################################
# http-poller-cm
#################################################################

demo:HttpPollerCm a tcs:PipelineComponent, dcat:DataService ;
  rdfs:label "HTTP poller (cm)" ;
  rdfs:comment "Polls an HTTP sensor endpoint and emits measurements in centimetres." ;
  rdfc:jsImplementationOf rdfc:Processor ;
  rdfc:class "HttpPollerCm" ;
  rdfc:file <./dist/http-poller-cm.js> ;
  rdfc:entrypoint <./> ;
  owl:imports <./node_modules/@dishacled/demo-processors/processors.ttl> ;
  dcterms:requires [
    a spdx:Package ;
    spdx:name "@dishacled/demo-processors" ;
    spdx:versionInfo "^0.1.0" ;
    spdx:suppliedBy :npm ;
  ] ;
  dcterms:conformsTo demo:SensorReadingShape, demo:MeasurementsInCmShape ;
  dcat:qualifiedRelation [
    a dcat:Relationship ;
    dcat:hadRole tcs:configShape ;
    dcterms:relation [
      a sh:NodeShape ;
      sh:targetClass demo:HttpPollerCm ;
      sh:property [
        sh:path rdfc:url ;
        sh:name "url" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
      ] , [
        sh:path rdfc:interval ;
        sh:name "pollInterval" ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:order 1 ;
      ] , [
        sh:path rdfc:output ;
        sh:name "output" ;
        sh:class rdfc:Writer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 2 ;
      ]
    ]
  ] , [
    a dcat:Relationship ;
    dcat:hadRole tcs:inputShape ;
    dcterms:relation demo:SensorReadingShape ;
  ] , [
    a dcat:Relationship ;
    dcat:hadRole tcs:outputShape ;
    dcterms:relation demo:MeasurementsInCmShape ;
  ] .

# The raw payload both pollers read off the wire, before it is typed as a
# measurement in a specific unit. Referenced by IRI from http-poller-cm and
# inlined as a blank node in http-poller-mm, so both spellings occur for real.
demo:SensorReadingShape a sh:NodeShape ;
  rdfs:label "Raw sensor reading" ;
  sh:targetClass demo:SensorReading ;
  sh:property [
    sh:path demo:reading ;
    sh:name "reading" ;
    sh:datatype xsd:decimal ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 0 ;
  ] , [
    sh:path demo:sensorId ;
    sh:name "sensorId" ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 1 ;
  ] .


#################################################################
# http-poller-mm
#
# Its input shape is written inline as a blank node rather than referenced by
# IRI -- the other shape form the parser has to handle.
#################################################################

demo:HttpPollerMm a tcs:PipelineComponent, dcat:DataService ;
  rdfs:label "HTTP poller (mm)" ;
  rdfs:comment "Polls an HTTP sensor endpoint and emits measurements in millimetres." ;
  rdfc:jsImplementationOf rdfc:Processor ;
  rdfc:class "HttpPollerMm" ;
  rdfc:file <./dist/http-poller-mm.js> ;
  rdfc:entrypoint <./> ;
  owl:imports <./node_modules/@dishacled/demo-processors/processors.ttl> ;
  dcterms:requires [
    a spdx:Package ;
    spdx:name "@dishacled/demo-processors" ;
    spdx:versionInfo "^0.1.0" ;
    spdx:suppliedBy :npm ;
  ] ;
  dcterms:conformsTo demo:MeasurementsInMmShape ;
  dcat:qualifiedRelation [
    a dcat:Relationship ;
    dcat:hadRole tcs:configShape ;
    dcterms:relation [
      a sh:NodeShape ;
      sh:targetClass demo:HttpPollerMm ;
      sh:property [
        sh:path rdfc:url ;
        sh:name "url" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
      ] , [
        sh:path rdfc:interval ;
        sh:name "pollInterval" ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:order 1 ;
      ] , [
        sh:path rdfc:output ;
        sh:name "output" ;
        sh:class rdfc:Writer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 2 ;
      ]
    ]
  ] , [
    a dcat:Relationship ;
    dcat:hadRole tcs:inputShape ;
    dcterms:relation [
      a sh:NodeShape ;
      sh:targetClass demo:SensorReading ;
      sh:property [
        sh:path demo:reading ;
        sh:name "reading" ;
        sh:datatype xsd:decimal ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
      ] , [
        sh:path demo:sensorId ;
        sh:name "sensorId" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 1 ;
      ]
    ]
  ] , [
    a dcat:Relationship ;
    dcat:hadRole tcs:outputShape ;
    dcterms:relation demo:MeasurementsInMmShape ;
  ] .


#################################################################
# Dataset -- output shape only
#
# A dataset produces data but consumes none, so it declares no input role and
# no config shape.
#################################################################

demo:SensorFeedCm a dcat:Dataset ;
  rdfs:label "Sensor feed (cm)" ;
  rdfs:comment "Recorded feed of centimetre measurements, replayable as a pipeline source." ;
  dcterms:conformsTo demo:MeasurementsInCmShape ;
  dcat:qualifiedRelation [
    a dcat:Relationship ;
    dcat:hadRole tcs:outputShape ;
    dcterms:relation demo:MeasurementsInCmShape ;
  ] .

#################################################################
# The alert contract
#
# `oslc:Error` is what the demonstrator's threshold monitor writes and what
# Elody ingests and visualises (A1/A2). The shape below is copied VERBATIM
# from the processor's own `processor.ttl`, under the same IRI it publishes
# it at, so it is literally the upstream definition rather than a paraphrase:
#
#   repo    https://github.com/rdf-connect/threshhold-monitor-processor
#           (three h's -- the two-h spelling is a different, non-existent repo)
#   branch  master  (there is no `main`)
#   file    processor.ttl, where the prefix `ex:` is bound to
#           <http://lblod.data.gift/shapes/> -- NOT to example.org, which the
#           same README's pipeline snippet misleadingly binds it to.
#
# Declaring it here once, as a component's output shape, is what lets the
# chain validation, the exported pipeline definition and the hand-off to
# redpencil all read the same triples. `api/apps/dishacled/shacl/catalog/
# alerts.ttl` is sample data validated against exactly this shape.
#################################################################

lblodsh:ErrorShape
    a sh:NodeShape;
    sh:targetClass oslc:Error;

    sh:property [
        sh:path mu:uuid;
        sh:name "uuid";
        sh:datatype xsd:string;
        sh:minCount 1;
        sh:maxCount 1;
    ], [
        sh:path dct:subject;
        sh:name "subject";
        sh:description "Service that failed and threw the error.";
        sh:datatype xsd:string;
        sh:minCount 1;
        sh:maxCount 1;
    ], [
        sh:path oslc:message;
        sh:name "message";
        sh:description "Short description of what functionally went wrong.";
        sh:datatype xsd:string;
        sh:minCount 1;
        sh:maxCount 1;
    ], [
        sh:path dct:created;
        sh:name "created";
        sh:description "Time the error occurred and was logged.";
        sh:datatype xsd:dateTime;
        sh:minCount 1;
        sh:maxCount 1;
    ], [
        sh:path dct:creator;
        sh:name "creator";
        sh:description "Service that threw the error.";
        sh:nodeKind sh:IRI;
        sh:minCount 1;
        sh:maxCount 1;
    ], [
        sh:path oslc:largePreview;
        sh:name "detail";
        sh:description "Detail of the error, e.g. stacktrace or request dump.";
        sh:datatype xsd:string;
        sh:maxCount 1;
    ], [
        sh:path dct:references;
        sh:name "references";
        sh:description "Resource the error is related to.";
        sh:nodeKind sh:IRI;
        sh:maxCount 1;
    ].


#################################################################
# threshold-monitor -- the alert producer
#
# A real published processor, so this entry is an overlay: it adds the output
# shape to the repository Elody already discovers on GitHub. `dcat:landingPage`
# is what marks it as having a home elsewhere, which keeps it from also being
# served as a local catalog-only component.
#
# No `spdx:Package` / `owl:imports` here on purpose -- the deployment
# coordinates are read off the repository's own package.json, and an empty
# deployment in a contract deliberately does not overwrite them.
#
# No input shape: the processor reads SDS members, whose shape is a property
# of the stream rather than of the processor, so the input port stays untyped.
#################################################################

tm:ThresholdMonitorJs a tcs:PipelineComponent, dcat:DataService ;
  rdfs:label "Threshold monitor" ;
  rdfs:comment "Watches a stream of measurements and writes an oslc:Error whenever a value falls outside the configured bounds." ;
  dcat:landingPage <https://github.com/rdf-connect/threshhold-monitor-processor> ;
  dcterms:conformsTo lblodsh:ErrorShape ;
  dcat:qualifiedRelation [
    a dcat:Relationship ;
    dcat:hadRole tcs:outputShape ;
    dcterms:relation lblodsh:ErrorShape ;
  ] .


#################################################################
# sparql-ingest -- the alert consumer
#
# Closes the chain: threshold-monitor's output shape and sparql-ingest's input
# shape are the same IRI, so `ThresholdMonitorJs -> SPARQLIngest` validates,
# while `ThresholdMonitorCm -> SPARQLIngest` (a measurement, not an alert)
# does not. Overlay on a real repository, same rules as above.
#################################################################

rdfc:SPARQLIngest a tcs:PipelineComponent, dcat:DataService ;
  rdfs:label "SPARQL ingest" ;
  rdfs:comment "Writes incoming members into a SPARQL store via SPARQL Update." ;
  dcat:landingPage <https://github.com/rdf-connect/sparql-ingest-processor-ts> ;
  dcterms:conformsTo lblodsh:ErrorShape ;
  dcat:qualifiedRelation [
    a dcat:Relationship ;
    dcat:hadRole tcs:inputShape ;
    dcterms:relation lblodsh:ErrorShape ;
  ] , [
    # local demo addition: the ingest passes the alerts through to the store
    # unchanged, so consumers of the store (dashboard, error alert) chain on.
    a dcat:Relationship ;
    dcat:hadRole tcs:outputShape ;
    dcterms:relation lblodsh:ErrorShape ;
  ] .


#################################################################
# The alert store -- output shape only
#
# The local SPARQL endpoint seeded with sample alerts, declared as a dataset so
# the endpoint is machine-readable and so A1 has a source it can pick in the
# pipeline builder. No `dcat:landingPage`: this one has no repository and is
# served from the catalog itself.
#
# The endpoint IRI is the in-network address; the browser-facing one goes
# through Traefik. Both are in `.env.dist` as ALERT_SPARQL_ENDPOINT and
# ALERT_SPARQL_ENDPOINT_EXT -- see docs/alert-fixture.md.
#################################################################

demo:AlertStore a dcat:Dataset ;
  rdfs:label "Alert store" ;
  rdfs:comment "Local SPARQL endpoint seeded with sample oslc:Error alerts, standing in for redpencil's error graph." ;
  dcat:endpointURL <http://triplestore-dishacled-wp3-prototype-elody:3030/alerts/sparql> ;
  dcat:accessURL <http://triplestore.dishacled-wp3-prototype-elody.localhost:8000/alerts/sparql> ;
  dcterms:conformsTo lblodsh:ErrorShape ;
  dcat:qualifiedRelation [
    a dcat:Relationship ;
    dcat:hadRole tcs:outputShape ;
    dcterms:relation lblodsh:ErrorShape ;
  ] .

#################################################################
# rml-processor-jvm -- deployment coordinates only
#
# An overlay (`dcat:landingPage`): the component itself is discovered on
# GitHub, and this entry adds the one thing the repository cannot supply. A
# jvm processor has no package.json or pyproject.toml for coordinates to be
# read off, so without this the exported pipeline names `rdfc:RmlMapper` and
# the runner has nothing to resolve it from -- it starts, finds no processor
# definition, and runs nothing.
#
# The path is the conventional one: it is where the RDF-Connect tutorial and
# the toolchain's own demonstrator put the built jar, relative to the pipeline
# file. Change it here if your build puts it elsewhere. The runner's own
# definition is separate and is configuration -- RDFC_JVM_RUNNER_IMPORT.
#
# No shapes: the processor's own `index.ttl` already describes its config, and
# restating it here would be a second copy to keep in step.
#################################################################

rdfc:RmlMapper a tcs:PipelineComponent, dcat:DataService ;
  rdfs:label "RML mapper" ;
  rdfs:comment "Maps source data to RDF with an RML mapping." ;
  dcat:landingPage <https://github.com/rdf-connect/rml-processor-jvm> ;
  owl:imports <./build/plugins/rml-processor-jvm-master-SNAPSHOT-all.jar> .

# ===== BEGIN local demo copy: DiSHACLed/demonstrator@proposal catalogs (Koen) =====
# Source: https://github.com/DiSHACLed/demonstrator/tree/proposal (catalogs/)
# Local fixes: missing prefixes (loket/rdfs/dash/shacl-play), iana media-type IRIs,
# and dcat:landingPage -> rdfs:seeAlso so these serve as local picker components
# (landingPage marks a GitHub-overlay in contracts.py and would hide them).

# ----- from data.ttl -----
@prefix dash: <http://datashapes.org/dash#> .
@prefix shacl-play: <https://shacl-play.sparna.fr/ontology#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix iana:    <https://www.iana.org/assignments/media-types/> .
@prefix ex:      <https://example.org/> .
@prefix graphs:  <https://example.org/shapes-graphs/> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix shape:   <http://www.example.org/shapes/> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema:  <http://schema.org/> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix geo:     <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix unit:    <http://qudt.org/vocab/unit/> .

ex:water-measurements
    a dcat:Dataset ;
    dct:title "Water Measurements"@en ;
    dcat:distribution ex:water-measurements-api, ex:water-measurements-sample .

ex:water-measurements-api
    a dcat:Distribution ;
    dct:title "Water Measurements Distribution (ld-json api)"@en ;
    dct:format "application/ld+json" ;  
    dcat:endpointURL "https://dishacled-api.azurewebsites.net/api/v1/source-a/current" .

ex:water-measurements-sample
    # dcat:Dataset added locally: ports_for_component only synthesises the
    # output port for datasets, and the picker serves this sample as source.
    a dcat:Distribution, dcat:Dataset ;
    dct:title "Water Measurements Sample [2026, 24th of August, 12:00 / 15 min]"@en ;
    dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
    dcat:downloadURL <https://dishacled-api.azurewebsites.net/api/v1/source-a/sample-a-20260824-15m.ttl> ;
    dcterms:conformsTo shape:Observation, shape:QuantityValue ;
    rdfs:label "Water measurements API (sample)" ;
    # Local demo tweak: same output shape as Sensor feed (cm), so this dataset
    # can be the chain's source and validate against HTTP poller (cm)'s input.
    dcat:qualifiedRelation [
        a dcat:Relationship ;
        dcat:hadRole tcs:outputShape ;
        dct:relation <https://dishacled.github.io/demo#MeasurementsInCmShape>
    ] .

# ! below auto-generated shapes from SHACL-play

shape:QuantityValue_unit
        sh:hasValue  unit:MilliM ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "unit"@en ;
        sh:nodeKind  sh:IRI ;
        sh:path      qudt:unit .

shape:Observation_hasResult
        sh:class     qudt:QuantityValue ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "hasResult"@en ;
        sh:nodeKind  sh:IRI ;
        sh:path      sosa:hasResult .

shape:Observation_madeBySensor
        sh:hasValue  ex:sensor1 ;
        sh:maxCount  1 ;
        sh:minCount  1 ;
        sh:name      "madeBySensor"@en ;
        sh:nodeKind  sh:IRI ;
        sh:path      sosa:madeBySensor .

shape:QuantityValue  rdf:type        sh:NodeShape ;
        rdfs:label                   "QuantityValue"@en ;
        sh:property                  shape:QuantityValue_unit , shape:QuantityValue_numericValue ;
        sh:targetClass               qudt:QuantityValue ;
        shacl-play:background-color  "orange" .

shape:QuantityValue_numericValue
        dash:propertyRole  dash:LabelRole ;
        sh:datatype        xsd:decimal ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "numericValue"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            qudt:numericValue .

shape:Observation  rdf:type          sh:NodeShape ;
        rdfs:label                   "Observation"@en ;
        sh:property                  shape:Observation_hasResult , shape:Observation_resultTime , shape:Observation_madeBySensor ;
        sh:targetClass               sosa:Observation ;
        shacl-play:background-color  "deeppink" .

shape:Observation_resultTime
        dash:propertyRole  dash:LabelRole ;
        sh:datatype        xsd:dateTime ;
        sh:maxCount        1 ;
        sh:minCount        1 ;
        sh:name            "resultTime"@en ;
        sh:nodeKind        sh:Literal ;
        sh:path            sosa:resultTime .

# ----- from sw.ttl -----
@prefix : <http://example.org/example/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix mu: <http://mu.semte.ch/vocabularies/core/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sw: <https://semantic.works/services/> .
@prefix tcs: <https://w3id.org/toolchain#> .

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix oslc: <http://open-services.net/ns/core#> .
@prefix nmo:  <http://www.semanticdesktop.org/ontologies/2007/03/22/nmo#> .
@prefix loket: <http://lblod.data.gift/shapes/loket-error-alert-service/> .

# ! We can use a generic config service for semantic works services (enough for what we are using here), providing the following support;
# 1. delta rule
# 2. docker variable
# 3. any file (path + contents)
# such configs can be easily handled by pipeline generator

# ! Afterwards, we can specify 
# 1.`tcs:wrappedConfigShape`'s for each service; these specify only the minimal spec required from user
# 2.`tcs:unwrapConfig` for each service

sw:genericSWConfigShape a sh:NodeShape.
# ....

sw:loket-error-alert-service a tcs:PipelineComponent, mu:Microservice, dcat:Resource ;
  rdfs:label "Error alert service" ;
  # local demo additions: accept the demo ErrorShape IRI alongside loket's own,
  # and declare one reader port so the service ranks/connects in the builder
  # (delivery is implicit through the central store at run time).
  dcat:qualifiedRelation [
    a dcat:Relationship ;
    dcat:hadRole tcs:inputShape ;
    dct:relation <http://lblod.data.gift/shapes/ErrorShape>
  ] , [
    a dcat:Relationship ;
    dcat:hadRole tcs:configShape ;
    dct:relation [
      a sh:NodeShape ;
      sh:property [
        sh:path <https://w3id.org/rdf-connect#alerts> ;
        sh:name "alerts" ;
        sh:class <https://w3id.org/rdf-connect#Reader> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
      ] , [
        sh:path <https://w3id.org/rdf-connect#emails> ;
        sh:name "emails" ;
        sh:class <https://w3id.org/rdf-connect#Writer> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
      ]
    ]
  ] ;
  rdfs:description "Service that is responsible for sending out alerts when errors are inserted in the store. Build using the MU Javascript template.";
  rdfs:seeAlso <https://github.com/lblod/loket-error-alert-service> ;
  dct:requires sw:triple-store ,
               sw:mu-delta-notifier ,
               sw:mu-identifier ;
  dcat:qualifiedRelation [
        dcat:hadRole tcs:inputShape ;
        dct:relation loket:ErrorShape
    ] ,
    [
        dcat:hadRole tcs:outputShape ;
        dct:relation loket:EmailShape
    ] ,
        [
        a dcat:Relationship;
        dcat:hadRole tcs:configShape ;
        dct:relation sw:genericSWConfigShape 
        ],
        [
        a dcat:Relationship;
        dcat:hadRole tcs:wrappedConfigShape ;
        dct:relation [
            a sh:NodeShape;
            # ...
            # the variables from here https://github.com/lblod/loket-error-alert-service#environment-variables
            # variable for string of template
            # with additional constraints that we can express
        ]
    ] ; 
    tcs:unwrapConfig "CONSTRUCT ...." # the delta rule is just a constant https://github.com/lblod/loket-error-alert-service#in-a-musemtech-stack, 
    # turning the template string into a file... (we can insert request triples to write a file as a hint for the pipeline generator to actually write the file with its contents)
    # the other variables from above translated trivially to docker variables
    .

sw:deliver-email-service a tcs:PipelineComponent, mu:Microservice, dcat:Resource ;
  rdfs:label "Deliver e-mail" ;
  # local demo additions: consume the EmailShape the error-alert service
  # produces (upstream says "MailShape, to verify") + one reader port.
  dcat:qualifiedRelation [
    a dcat:Relationship ;
    dcat:hadRole tcs:inputShape ;
    dct:relation loket:EmailShape
  ] , [
    a dcat:Relationship ;
    dcat:hadRole tcs:configShape ;
    dct:relation [
      a sh:NodeShape ;
      sh:property [
        sh:path <https://w3id.org/rdf-connect#emails> ;
        sh:name "emails" ;
        sh:class <https://w3id.org/rdf-connect#Reader> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
      ]
    ]
  ] ;
  rdfs:description "Microservice that delivers emails from a mail folder" ;
  rdfs:seeAlso <https://github.com/lblod/berichtencentrum-deliver-email-service> ;
  dct:requires sw:triple-store ,
               sw:mu-identifier ;
  dcat:qualifiedRelation 
        [
            dcat:hadRole tcs:inputShape ;
            dct:relation loket:EmailShape # local: aligned with error-alert's output (upstream said MailShape, to verify)
        ] ,
        [
        a dcat:Relationship;
        dcat:hadRole tcs:configShape ;
        dct:relation sw:genericSWConfigShape 
        ],
        [
        a dcat:Relationship;
        dcat:hadRole tcs:wrappedConfigShape ;
        dct:relation [
            a sh:NodeShape;
            # ...
            # the variables from here https://github.com/lblod/berichtencentrum-deliver-email-service#environment-variables
            # with additional constraints that we can express
        ]
    ] ; 
    tcs:unwrapConfig "CONSTRUCT ...." ; # no delta rules; no additional files
    # the variables from above translated trivially to docker variables
  tcs:config :DeliverEmailServiceDockerCompose .

# shapes can be more specific and depend on input but yeah...
# shapes defined by llm; to verify!

loket:ErrorShape a sh:NodeShape ;
    sh:targetClass oslc:Error ;

    sh:property [
        sh:path mu:uuid ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dct:subject ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path oslc:message ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dct:created ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dct:creator ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dct:references ;
        sh:nodeKind sh:IRI ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path oslc:largePreview ;
        sh:datatype xsd:string ;
        sh:minCount 0 ;
        sh:maxCount 1 ;
    ] .

loket:EmailShape a sh:NodeShape ;
    sh:targetClass nmo:Email ;

    sh:property [
        sh:path mu:uuid ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path nmo:isPartOf ;
        sh:nodeKind sh:IRI ;
        sh:hasValue <http://data.lblod.info/id/mail-folders/2> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path nmo:messageSubject ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path nmo:htmlMessageContent ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path nmo:emailTo ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path nmo:messageFrom ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dct:creator ;
        sh:nodeKind sh:IRI ;
        sh:hasValue <http://lblod.data.gift/services/loket-error-alert-service> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path dct:references ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node loket:ErrorReadShape ;
    ] .

# ----- from ldio.ttl -----
@prefix : <http://example.org/example/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ldio: <http://example.org/example/ldio/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix tcs: <https://w3id.org/toolchain#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ldio:HttpInPoller a tcs:PipelineComponent, dcat:Resource;
    rdfs:label "Ldio:HttpInPoller" ; 
    rdfs:description "The LDIO Http In Poller is a basic Http Poller that will poll a target URL on a specified interval.";
    ldio:type "Input" ;
    rdfs:seeAlso "https://informatievlaanderen.github.io/VSDS-Linked-Data-Interactions/2.8.0-SNAPSHOT/ldio/ldio-inputs/ldio-http-in-poller" ;
    dct:requires ldio:LinkedDataInteractionsOrchestrator ;
    dcat:qualifiedRelation [
        a dcat:Relationship;
        dcat:hadRole tcs:wrappedConfigShape ;
        dct:relation [
          a sh:NodeShape 
          # checking that api has indeed json+ld as format...
       ]
       ],
      [
        a dcat:Relationship;
        dcat:hadRole tcs:configShape ;
        dct:relation [
          a sh:NodeShape;
          sh:node ldio:HttpRequesterShape;
          sh:property [
              sh:path ldio:url;
              sh:name "url";
              sh:description "Target URL to poll from.";
              sh:datatype xsd:string;
              sh:minCount 1; # Lists are supported
          ], [
            sh:path ldio:cron;
            sh:name "cron";
            sh:description "Cron expression to declare when the polling should take place. Schedules are in UTC timezone.";
            sh:datatype xsd:string;
            sh:minCount 1; # Required unless `interval` is used instead (interval is on a deprecation path per the docs)
            sh:maxCount 1;
         ], [
            sh:path ldio:interval;
            sh:name "interval";
            sh:description "Polling interval declared in ISO 8601 format.";
            sh:datatype xsd:string;
            sh:maxCount 1;
         ], [
            sh:path ldio:continueOnFail;
            sh:name "continueOnFail";
            sh:description "Indicates if polling should continue if a previous poll resulted in failure.";
            sh:datatype xsd:boolean;
            sh:maxCount 1;
         ]
        ]
        ] ;
        tcs:unwrapConfig "CONSTRUCT ..." ;
        tcs:resolver tcs:apiCheck
.




# ----- local additions for the guided suggestion chain -----
# Alert monitor: the threshold check that *emits* alerts (the per-unit
# ThresholdMonitor(Cm|Mm) stay deliberately pass-through for the cm/mm
# mismatch demo; this one turns measurements into oslc:Error alerts, so the
# suggestion chain can continue towards the store and the dashboard).
demo:AlertMonitorCm a tcs:PipelineComponent, dcat:DataService, dcat:Resource ;
  rdfs:label "Alert monitor (cm)" ;
  rdfs:comment "Checks centimetre measurements against a threshold and emits an oslc:Error alert on violation." ;
  rdfc:jsImplementationOf rdfc:Processor ;
  rdfc:class "AlertMonitorCm" ;
  dcat:qualifiedRelation [
    a dcat:Relationship ;
    dcat:hadRole tcs:configShape ;
    dcterms:relation [
      a sh:NodeShape ;
      sh:targetClass demo:AlertMonitorCm ;
      sh:property [
        sh:path rdfc:threshold ;
        sh:name "threshold" ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
      ] , [
        sh:path rdfc:input ;
        sh:name "input" ;
        sh:class rdfc:Reader ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 1 ;
      ] , [
        sh:path rdfc:output ;
        sh:name "output" ;
        sh:class rdfc:Writer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 2 ;
      ]
    ]
  ] , [
    a dcat:Relationship ;
    dcat:hadRole tcs:inputShape ;
    dcterms:relation demo:MeasurementsInCmShape ;
  ] , [
    a dcat:Relationship ;
    dcat:hadRole tcs:outputShape ;
    dcterms:relation lblodsh:ErrorShape ;
  ] .

# The Elody alert dashboard as a pipeline component (ticket #164374): a
# declarative consumer — input contract is the alert shape, delivery runs
# implicitly through the central store, no runtime code.
demo:ElodyAlertDashboard a tcs:PipelineComponent, dcat:DataService, dcat:Resource ;
  rdfs:label "Alert dashboard (Elody)" ;
  rdfs:comment "Renders oslc:Error alerts from the central store as a SHACL-driven dashboard in Elody." ;
  dcat:qualifiedRelation [
    a dcat:Relationship ;
    dcat:hadRole tcs:configShape ;
    dcterms:relation [
      a sh:NodeShape ;
      sh:targetClass demo:ElodyAlertDashboard ;
      # one reader port so the alerts input is connectable in the builder;
      # at run time the delivery is implicit through the central store
      sh:property [
        sh:path rdfc:alerts ;
        sh:name "alerts" ;
        sh:class rdfc:Reader ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
      ]
    ]
  ] , [
    a dcat:Relationship ;
    dcat:hadRole tcs:inputShape ;
    dcterms:relation lblodsh:ErrorShape ;
  ] .


# The mm twin of the alert monitor (Koen's suggestion, 2026-08-28): a text
# search for "alert monitor" shows both variants, while the shape-guided
# suggestions automatically keep only the one matching the chain's unit.
demo:AlertMonitorMm a tcs:PipelineComponent, dcat:DataService, dcat:Resource ;
  rdfs:label "Alert monitor (mm)" ;
  rdfs:comment "Checks millimetre measurements against a threshold and emits an oslc:Error alert on violation." ;
  rdfc:jsImplementationOf rdfc:Processor ;
  rdfc:class "AlertMonitorMm" ;
  dcat:qualifiedRelation [
    a dcat:Relationship ;
    dcat:hadRole tcs:configShape ;
    dcterms:relation [
      a sh:NodeShape ;
      sh:targetClass demo:AlertMonitorMm ;
      sh:property [
        sh:path rdfc:threshold ;
        sh:name "threshold" ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
      ] , [
        sh:path rdfc:input ;
        sh:name "input" ;
        sh:class rdfc:Reader ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 1 ;
      ] , [
        sh:path rdfc:output ;
        sh:name "output" ;
        sh:class rdfc:Writer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 2 ;
      ]
    ]
  ] , [
    a dcat:Relationship ;
    dcat:hadRole tcs:inputShape ;
    dcterms:relation demo:MeasurementsInMmShape ;
  ] , [
    a dcat:Relationship ;
    dcat:hadRole tcs:outputShape ;
    dcterms:relation lblodsh:ErrorShape ;
  ] .

# ===== END local demo copy =====
